{
  "name": "角色档案",
  "version": 1,
  "description": "示例模板：把一个角色的底细固定下来。适合人物多、容易记混的长线剧情。导入后在「记录」页用它单独建档。",
  "fields": [
    {
      "id": "title",
      "label": "姓名 / 称呼",
      "type": "text",
      "group": "main",
      "required": true,
      "placeholder": "角色常用名"
    },
    {
      "id": "category",
      "label": "分类",
      "type": "select",
      "group": "main",
      "options": ["主角", "配角", "反派", "路人", "其他"]
    },
    {
      "id": "relation",
      "label": "与我的关系",
      "type": "text",
      "group": "main",
      "placeholder": "盟友 / 宿敌 / 债主…"
    },
    {
      "id": "impression",
      "label": "印象与说话方式",
      "type": "textarea",
      "group": "main",
      "placeholder": "口癖、语气、身体习惯"
    },
    {
      "id": "identity",
      "label": "身份背景",
      "type": "textarea",
      "group": "extra",
      "placeholder": "出身、职业、过去的经历"
    },
    {
      "id": "secret",
      "label": "秘密 / 伏笔",
      "type": "textarea",
      "group": "extra",
      "placeholder": "还没揭穿的事"
    },
    {
      "id": "attitude",
      "label": "对我的态度变化",
      "type": "textarea",
      "group": "extra",
      "placeholder": "从戒备到…"
    },
    {
      "id": "tags",
      "label": "标签",
      "type": "tags",
      "group": "extra",
      "placeholder": "输入后按回车"
    }
  ]
}
