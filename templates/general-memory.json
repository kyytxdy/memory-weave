{
  "name": "事件档案",
  "version": 2,
  "description": "普通模式模板：每次新建一条，进时间线。适合手动归档值得长期记住的事件、设定、承诺。想只保留最新一条请用快照模式。",
  "fields": [
    {
      "id": "title",
      "label": "标题",
      "type": "text",
      "group": "main",
      "required": true,
      "placeholder": "一句话概括，如「初遇时的那场雨」"
    },
    {
      "id": "category",
      "label": "分类",
      "type": "select",
      "group": "main",
      "options": [
        "事件",
        "人物",
        "地点",
        "物品",
        "规则",
        "关系",
        "承诺",
        "其他"
      ]
    },
    {
      "id": "subject",
      "label": "涉及对象",
      "type": "text",
      "group": "main",
      "placeholder": "这件事和谁有关"
    },
    {
      "id": "detail",
      "label": "经过 / 内容",
      "type": "textarea",
      "group": "main",
      "placeholder": "发生了什么，说清了什么"
    },
    {
      "id": "when",
      "label": "时间",
      "type": "text",
      "group": "extra",
      "placeholder": "故事内的第几天 / 季节"
    },
    {
      "id": "place",
      "label": "地点",
      "type": "text",
      "group": "extra",
      "placeholder": "在哪里发生的"
    },
    {
      "id": "quote",
      "label": "关键台词",
      "type": "textarea",
      "group": "extra",
      "placeholder": "值得原样记住的一句话"
    },
    {
      "id": "change",
      "label": "影响 / 变化",
      "type": "textarea",
      "group": "extra",
      "placeholder": "关系、立场、心境上的变化"
    },
    {
      "id": "tags",
      "label": "标签",
      "type": "tags",
      "group": "extra",
      "placeholder": "输入后按回车"
    }
  ]
}